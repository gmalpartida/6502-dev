AS	Makefile	/^AS=\/opt\/vbcc\/bin\/vasm6502_oldstyle$/;"	m
AS_FLAGS	Makefile	/^AS_FLAGS=-I $(INC_DIR) -Fvobj -sect -wfail -dotdir $/;"	m
