Sections:
00: ".text" (0-71)
01: ".vectors" (0-6)


Source: "test_io_port.s"
                        	     1: ; --- Hardware Map ---
                        	     2: VIA_BASE  = $C000   ; Y6
                        	     3: UART_BASE = $A000   ; Y5
                        	     4: TICKS     = $00     ; RAM counter
                        	     5: 
                        	     6: ; UART Register Offsets
                        	     7: RBR_THR   = UART_BASE + 0
                        	     8: DLL       = UART_BASE + 0
                        	     9: DLM       = UART_BASE + 1
                        	    10: LCR       = UART_BASE + 3
                        	    11: LSR       = UART_BASE + 5
                        	    12: 
                        	    13: .section .text
                        	    14: RESET:
00:0000 A2FF            	    15:     LDX #$FF
00:0002 9A              	    16:     TXS             ; Always init stack first!
                        	    17: 
                        	    18:     ; --- 1. Initialize VIA (Walking Bit) ---
00:0003 A9FF            	    19:     LDA #$FF
00:0005 8D03C0          	    20:     STA VIA_BASE + 3 ; DDRA = Output
00:0008 A901            	    21:     LDA #$01
00:000A 8D01C0          	    22:     STA VIA_BASE + 1 ; Initial LED (Port A)
                        	    23:     
00:000D A914            	    24:     LDA #20          ; Soft-divider for 5Hz
00:000F 8500            	    25:     STA TICKS
                        	    26: 
                        	    27:     ; --- 2. Initialize UART (9600 Baud @ 2.88MHz) ---
00:0011 A980            	    28:     LDA #$80         ; Access Divisor Latches (DLAB=1)
00:0013 8D03A0          	    29:     STA LCR
00:0016 A913            	    30:     LDA #$13         ; Divisor = 19 ($13)
00:0018 8D00A0          	    31:     STA DLL
00:001B A900            	    32:     LDA #$00
00:001D 8D01A0          	    33:     STA DLM
00:0020 A903            	    34:     LDA #$03         ; 8 data bits, 1 stop, No parity (DLAB=0)
00:0022 8D03A0          	    35:     STA LCR
                        	    36: 
                        	    37:     ; --- 3. Test Transmission (Send "!" to PC) ---
                        	    38:     ; Calling test_tx here confirms the 5.76MHz bus can write to UART
                        	    39: 
00:0025 A948            	    40: 	lda #'H'
00:0027 206500          	    41: 	jsr uart_tx_char
00:002A A965            	    42: 	lda #'e'
00:002C 206500          	    43: 	jsr uart_tx_char
00:002F A96C            	    44: 	lda #'l'
00:0031 206500          	    45: 	jsr uart_tx_char
                        	    46: 
                        	    47: 
                        	    48:     ; --- 4. Configure VIA Timer 1 (Interrupts) ---
                        	    49:     ; 5.76MHz / 100Hz = 57,600 ($E100)
00:0034 A900            	    50:     LDA #$00
00:0036 8D04C0          	    51:     STA VIA_BASE + 4 ; T1C-L
00:0039 A9E1            	    52:     LDA #$E1
00:003B 8D05C0          	    53:     STA VIA_BASE + 5 ; T1C-H (Starts Timer)
                        	    54:     
00:003E A940            	    55:     LDA #%01000000   ; Continuous interrupts
00:0040 8D0BC0          	    56:     STA VIA_BASE + $B ; ACR
00:0043 A9C0            	    57:     LDA #%11000000   ; Enable T1 IRQ
00:0045 8D0EC0          	    58:     STA VIA_BASE + $E ; IER
                        	    59: 
00:0048 58              	    60:     CLI              ; Enable Interrupts
                        	    61:     
                        	    62: IDLE:
00:0049 CB              	    63:     WAI              ; CPU sleeps until VIA fires
00:004A 80FD            	    64:     BRA IDLE
                        	    65: 
                        	    66: ; --- Interrupt Service Routine ---
                        	    67: ISR:
00:004C 48              	    68:     PHA
00:004D 2C04C0          	    69:     BIT VIA_BASE + 4 ; Clear VIA flag
                        	    70:     
00:0050 C600            	    71:     DEC TICKS
00:0052 D00F            	    72:     BNE EXIT
                        	    73:     
00:0054 A914            	    74:     LDA #20          ; Reset divider
00:0056 8500            	    75:     STA TICKS
                        	    76:     
                        	    77:     ; Walk bit on Port A
00:0058 AD01C0          	    78:     LDA VIA_BASE + 1
00:005B 0A              	    79:     ASL
00:005C D002            	    80:     BNE store
00:005E A901            	    81:     LDA #$01
                        	    82: store:
00:0060 8D01C0          	    83:     STA VIA_BASE + 1
                        	    84: 
                        	    85: EXIT:
00:0063 68              	    86:     PLA
00:0064 40              	    87:     RTI
                        	    88: 
                        	    89: ; transmits one ascii character via the uart
                        	    90: ; --> a: contains character to be sent
                        	    91: ; <-- none
                        	    92: uart_tx_char:
00:0065 AD05A0          	    93:     LDA LSR          	; Read Line Status Register
00:0068 2920            	    94:     AND #$20         	; Check THRE bit (Transmit Holding Reg Empty)
00:006A F0F9            	    95:     BEQ uart_tx_char	; Wait if busy
00:006C EA              	    96: 	nop				 	; slow it down a little bit
00:006D 8D00A0          	    97:     STA RBR_THR      	; Send it!
00:0070 60              	    98: 	rts
                        	    99: 
                        	   100: 	.section .vectors
01:0000 0000            	   101:     .word $0000      ; NMI
01:0002 0000            	   102:     .word RESET      ; RESET
01:0004 4C00            	   103:     .word ISR        ; IRQ at $FFFE
                        	   104: 
                        	   105: 


