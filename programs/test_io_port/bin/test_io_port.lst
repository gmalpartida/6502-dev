                        	   140: 	.section .vectors
01:0000 0000            	   141:     .word $0000      ; NMI
01:0002 0000            	   142:     .word RESET      ; RESET
01:0004 3900            	   143:     .word ISR        ; IRQ at $FFFE
                        	   144: 
                        	   145: 	.section .text
