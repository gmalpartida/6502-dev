                        	     2: ; Zero Page Register File (example starts at $00)
                        	     3: R0   = $00
                        	     4: R1   = $01
                        	     5: R2   = $02
                        	     6: R3   = $03
                        	     7: R4   = $04
                        	     8: R5   = $05
                        	     9: R6   = $06
                        	    10: R7   = $07
