Source: "test_io_port.s"
                        	     1: ; --- Hardware Map ---
                        	     2: VIA_BASE  = $C000   ; Y6
                        	     3: UART_BASE = $A000   ; Y5
                        	     4: TICKS     = $00     ; RAM counter
                        	     5: VIA_PORTA = VIA_BASE + 1
                        	     6: VIA_DDRA = VIA_BASE + 3
                        	     7: 
                        	     8: 
                        	     9: ; UART Register Offsets
                        	    10: RBR_THR   = UART_BASE + 0
                        	    11: DLL       = UART_BASE + 0
                        	    12: DLM       = UART_BASE + 1
                        	    13: LCR       = UART_BASE + 3
                        	    14: lsr       = UART_BASE + 5
                        	    15: 
                        	    16: .section .text
                        	    17: RESET:
00:0000 A2FF            	    18:     LDX #$FF
00:0002 9A              	    19:     TXS             ; Always init stack first!
                        	    20: 
                        	    21:     ; --- 1. Initialize VIA 
00:0003 A9FF            	    22:     LDA #$FF
00:0005 8D03C0          	    23:     STA VIA_DDRA ; DDRA = Output
                        	    24:     
00:0008 A9AA            	    25: 	lda #$aa
00:000A 8D01C0          	    26: 	sta VIA_PORTA
                        	    27:     ; --- 2. Initialize UART (9600 Baud @ 2.88MHz) ---
00:000D 202100          	    28: 	jsr uart_init
                        	    29: 
                        	    30: uart_echo_loop:
00:0010 A961            	    31: 	lda #'a'
00:0012 204000          	    32: 	jsr uart_tx_char
                        	    33: 
00:0015 205F00          	    34: 	jsr uart_rx_char
                        	    35: 
00:0018 8D01C0          	    36: 	sta VIA_PORTA
                        	    37: 
00:001B 4C1000          	    38: 	jmp uart_echo_loop
                        	    39: 
                        	    40: halt:
00:001E 4C1E00          	    41: 	jmp halt
                        	    42: 
                        	    43: uart_init:
                        	    44: 
                        	    45:     ; Disable Interrupts (since you are polling)
00:0021 A900            	    46:     LDA #$00
00:0023 8D01A0          	    47:     STA $A001       ; IER
                        	    48: 
                        	    49:     ; Set Baud Rate (Requires DLAB=1)
00:0026 A980            	    50:     LDA #$80        ; Bit 7 = 1 (DLAB)
00:0028 8D03A0          	    51:     STA $A003       ; LCR
00:002B A913            	    52:     LDA #$13        ; Divisor Low (for 9600 @ 2.88MHz)
00:002D 8D00A0          	    53:     STA $A000       ; DLL
00:0030 A900            	    54:     LDA #$00        ; Divisor High
00:0032 8D01A0          	    55:     STA $A001       ; DLM
                        	    56: 
                        	    57:     ; Configure Format & CLOSE DLAB (Crucial!)
00:0035 A903            	    58:     LDA #$03        ; 8 bits, 1 stop bit, No parity, DLAB=0
00:0037 8D03A0          	    59:     STA $A003       ; LCR - Receiver/Transmitter now accessible
                        	    60: 
                        	    61:     ; Assert Modem Handshakes
                        	    62:     ; Even if you aren't using them, the UART logic often needs these "Active"
00:003A A903            	    63:     LDA #$03        ; Bit 0 (DTR) and Bit 1 (RTS) set to 1 (Active)
00:003C 8D04A0          	    64:     STA $A004       ; MCR (Modem Control Register)
                        	    65: 
00:003F 60              	    66:     RTS
                        	    67: 
                        	    68: ; transmits one ascii character via the uart
                        	    69: ; --> a: contains character to be sent
                        	    70: ; <-- none
                        	    71: uart_tx_char:
00:0040 AA              	    72: 	tax
                        	    73: uart_tx_char_wait:
00:0041 AD05A0          	    74:     LDA lsr          	; Read Line Status Register
00:0044 2920            	    75:     AND #$20         	; Check THRE bit (Transmit Holding Reg Empty)
00:0046 F0F9            	    76:     BEQ uart_tx_char_wait	; Wait if busy
00:0048 EA              	    77: 	nop				 	; slow it down a little bit
00:0049 8A              	    78: 	txa
00:004A 8D00A0          	    79:     STA RBR_THR      	; Send it!
00:004D 60              	    80: 	rts
                        	    81: 
                        	    82: ; Usage: LDX #<msg_addr : LDY #>msg_addr : JSR print_str
                        	    83: uart_tx_asciz:
00:004E 8600            	    84:     stx $00         ; Use Zero Page $00/$01 as a pointer
00:0050 8401            	    85:     sty $01
00:0052 A000            	    86:     ldy #0
                        	    87: uart_tx_asciiz_loop:
00:0054 B100            	    88:     lda ($00), y    ; Get char
00:0056 F006            	    89:     beq done       ; Null terminator?
00:0058 204000          	    90:     jsr uart_tx_char
00:005B C8              	    91:     iny
00:005C D0F6            	    92:     bne uart_tx_asciiz_loop       ; Max 255 chars
                        	    93: done:
00:005E 60              	    94:     rts
                        	    95: 
                        	    96: uart_rx_char:
00:005F AD05A0          	    97: 	lda lsr
00:0062 2901            	    98: 	and #$01
00:0064 F0F9            	    99: 	beq uart_rx_char
00:0066 AD00A0          	   100: 	lda RBR_THR
00:0069 60              	   101: 	rts
                        	   102: 
                        	   103: uart_rx_asciiz:
                        	   104: 
                        	   105: 
00:006A 60              	   106: 	rts
                        	   107: 
                        	   108: print_hello_world:
                        	   109: 
00:006B A273            	   110: 	ldx #<hello_world_msg 
00:006D A000            	   111: 	ldy #>hello_world_msg
00:006F 204E00          	   112: 	jsr uart_tx_asciz
00:0072 60              	   113: 	rts
