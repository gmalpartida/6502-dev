Sections:
00: ".text" (0-A4)
01: ".vectors" (0-6)


Source: "test_io_port.s"
                        	     1: ; --- Hardware Map ---
                        	     2: VIA_BASE  = $C000   ; Y6
                        	     3: UART_BASE = $A000   ; Y5
                        	     4: TICKS     = $00     ; RAM counter
                        	     5: 
                        	     6: ; UART Register Offsets
                        	     7: RBR_THR   = UART_BASE + 0
                        	     8: DLL       = UART_BASE + 0
                        	     9: DLM       = UART_BASE + 1
                        	    10: LCR       = UART_BASE + 3
                        	    11: lsr       = UART_BASE + 5
                        	    12: 
                        	    13: .section .text
                        	    14: RESET:
00:0000 A2FF            	    15:     LDX #$FF
00:0002 9A              	    16:     TXS             ; Always init stack first!
                        	    17: 
                        	    18:     ; --- 1. Initialize VIA (Walking Bit) ---
00:0003 A9FF            	    19:     LDA #$FF
00:0005 8D03C0          	    20:     STA VIA_BASE + 3 ; DDRA = Output
00:0008 A901            	    21:     LDA #$01
00:000A 8D01C0          	    22:     STA VIA_BASE + 1 ; Initial LED (Port A)
                        	    23:     
00:000D A914            	    24:     LDA #20          ; Soft-divider for 5Hz
00:000F 8500            	    25:     STA TICKS
                        	    26: 
                        	    27:     ; --- 2. Initialize UART (9600 Baud @ 2.88MHz) ---
00:0011 208100          	    28: 	jsr uart_init
                        	    29: 
                        	    30:     ; --- 3. Test Transmission (Send "!" to PC) ---
                        	    31:     ; Calling test_tx here confirms the 5.76MHz bus can write to UART
                        	    32: 	;LDX #<hello_world_msg 
                        	    33: 	;LDY #>hello_world_msg
                        	    34: 	;JSR uart_tx_asciz
                        	    35: uart_echo_loop:
00:0014 207100          	    36: 	jsr uart_rx_char
00:0017 EA              	    37: 	nop
00:0018 EA              	    38: 	nop
00:0019 EA              	    39: 	nop
00:001A EA              	    40: 	nop
00:001B EA              	    41: 	nop
00:001C 205200          	    42: 	jsr uart_tx_char 
00:001F 4C1400          	    43: 	jmp uart_echo_loop
                        	    44: 
                        	    45:     ; --- 4. Configure VIA Timer 1 (Interrupts) ---
                        	    46:     ; 5.76MHz / 100Hz = 57,600 ($E100)
00:0022 A900            	    47:     LDA #$00
00:0024 8D04C0          	    48:     STA VIA_BASE + 4 ; T1C-L
00:0027 A9E1            	    49:     LDA #$E1
00:0029 8D05C0          	    50:     STA VIA_BASE + 5 ; T1C-H (Starts Timer)
                        	    51:     
00:002C A940            	    52:     LDA #%01000000   ; Continuous interrupts
00:002E 8D0BC0          	    53:     STA VIA_BASE + $B ; ACR
00:0031 A9C0            	    54:     LDA #%11000000   ; Enable T1 IRQ
00:0033 8D0EC0          	    55:     STA VIA_BASE + $E ; IER
                        	    56: 
                        	    57:     ;CLI              ; Enable Interrupts
                        	    58:     
                        	    59: IDLE:
                        	    60:     ;WAI              ; CPU sleeps until VIA fires
00:0036 4C3600          	    61:     jmp IDLE
                        	    62: 
                        	    63: ; --- Interrupt Service Routine ---
                        	    64: ISR:
00:0039 48              	    65:     PHA
00:003A 2C04C0          	    66:     BIT VIA_BASE + 4 ; Clear VIA flag
                        	    67:     
00:003D C600            	    68:     DEC TICKS
00:003F D00F            	    69:     BNE EXIT
                        	    70:     
00:0041 A914            	    71:     LDA #20          ; Reset divider
00:0043 8500            	    72:     STA TICKS
                        	    73:     
                        	    74:     ; Walk bit on Port A
00:0045 AD01C0          	    75:     LDA VIA_BASE + 1
00:0048 0A              	    76:     ASL
00:0049 D002            	    77:     BNE store
00:004B A901            	    78:     LDA #$01
                        	    79: store:
00:004D 8D01C0          	    80:     STA VIA_BASE + 1
                        	    81: 
                        	    82: EXIT:
00:0050 68              	    83:     PLA
00:0051 40              	    84:     RTI
                        	    85: 
                        	    86: ; transmits one ascii character via the uart
                        	    87: ; --> a: contains character to be sent
                        	    88: ; <-- none
                        	    89: uart_tx_char:
00:0052 AA              	    90: 	tax
                        	    91: uart_tx_char_wait:
00:0053 AD05A0          	    92:     LDA lsr          	; Read Line Status Register
00:0056 2920            	    93:     AND #$20         	; Check THRE bit (Transmit Holding Reg Empty)
00:0058 F0F9            	    94:     BEQ uart_tx_char_wait	; Wait if busy
00:005A EA              	    95: 	nop				 	; slow it down a little bit
00:005B 8A              	    96: 	txa
00:005C 8D00A0          	    97:     STA RBR_THR      	; Send it!
00:005F 60              	    98: 	rts
                        	    99: 
                        	   100: ; Usage: LDX #<msg_addr : LDY #>msg_addr : JSR print_str
                        	   101: uart_tx_asciz:
00:0060 8600            	   102:     stx $00         ; Use Zero Page $00/$01 as a pointer
00:0062 8401            	   103:     sty $01
00:0064 A000            	   104:     ldy #0
                        	   105: uart_tx_asciiz_loop:
00:0066 B100            	   106:     lda ($00), y    ; Get char
00:0068 F006            	   107:     beq done       ; Null terminator?
00:006A 205200          	   108:     jsr uart_tx_char
00:006D C8              	   109:     iny
00:006E D0F6            	   110:     bne uart_tx_asciiz_loop       ; Max 255 chars
                        	   111: done:
00:0070 60              	   112:     rts
                        	   113: 
                        	   114: uart_rx_char:
00:0071 AD05A0          	   115: 	lda lsr
00:0074 2901            	   116: 	and #$01
00:0076 F0F9            	   117: 	beq uart_rx_char
00:0078 EA              	   118: 	nop
00:0079 EA              	   119: 	nop
00:007A EA              	   120: 	nop
00:007B EA              	   121: 	nop
00:007C EA              	   122: 	nop
00:007D AD00A0          	   123: 	lda RBR_THR
00:0080 60              	   124: 	rts
                        	   125: 
                        	   126: uart_rx_asciiz:
                        	   127: 
                        	   128: 
                        	   129: uart_init:
00:0081 A980            	   130:     LDA #$80         ; Access Divisor Latches (DLAB=1)
00:0083 8D03A0          	   131:     STA LCR
00:0086 A913            	   132:     LDA #$13         ; Divisor = 19 ($13)
00:0088 8D00A0          	   133:     STA DLL
00:008B A900            	   134:     LDA #$00
00:008D 8D01A0          	   135:     STA DLM
00:0090 A903            	   136:     LDA #$03         ; 8 data bits, 1 stop, No parity (DLAB=0)
00:0092 8D03A0          	   137:     STA LCR
00:0095 60              	   138: 	rts
