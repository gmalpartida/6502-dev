ASxxxx Assembler V02.00 + NoICE + SDCC mods  (Rockwell 6502/6510/65C02) Page 2
Hexadecimal [24-Bits]



                                      1 	.area text (ABS, OVR)
      00E000                          2 	.org 0xe000
                                      3 
      00E000                          4 reset_isr:
      00E000 78               [ 2]    5     sei             ; Disable interrupts
      00E001 D8               [ 2]    6     cld             ; Clear decimal mode
      00E002 A2 FF            [ 2]    7     ldx #0hff        ; Initialize stack pointer to $01ff
      00E004 9A               [ 2]    8     txs
                                      9 
                                     10     ; Your code starts here
      00E005 A9 40            [ 2]   11     lda #0h40
      00E007 85 41            [ 3]   12     sta 0h41
      00E009 00               [ 7]   13     brk             ; Force a software interrupt (triggers irq_isr)
                                     14 
      00E00A                         15 nmi_isr:
      00E00A 40               [ 6]   16     rti             ; Return from Non-Maskable Interrupt
                                     17 
      00E00B                         18 irq_isr:
      00E00B 40               [ 6]   19     rti             ; Return from Maskable Interrupt / BRK
                                     20 
      00FFFA                         21 	.org 0xfffa
      00FFFA 0A E0                   22 	.word	nmi_isr		; nmi vector
      00FFFC 00 E0                   23 	.word	reset_isr	;points to start of code
      00FFFE 0B E0                   24 	.word	irq_isr		; irq vector
